      "id": "244c3853-4c49-4a28-94bb-90b08a6bb57a",
      "name": "OpenAI Answer"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{\n  {\n    answer: $json.choices[0].message.content\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1024,
        -144
      ],
      "id": "4bb9e008-865e-4d3d-b6bf-f12dce98547c",
      "name": "Respond to Webhook"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      model: \"gpt-4o-mini\",\n      temperature: 0.2,\n      messages: [\n        {\n          role: \"system\",\n          content: \"You are a Website Knowledge Bot. Answer only using the provided context. If the answer is not found, say: I couldn't find that on this website. Always include source URLs.\"\n        },\n        {\n          role: \"user\",\n          content: `Website: ${$json.websiteUrl}\n\nQuestion:\n${$json.question}\n\nContext:\n${$json.context}`\n        }\n      ]\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        -144
      ],
      "id": "193a1793-a104-4f5f-9ca7-577548922f25",
      "name": "Build OpenAI Body"
    },
    {
      "parameters": {
        "jsCode": "const websiteUrl = $json.body.websiteUrl.trim().replace(/\\/$/, '');\n\nconst collectionName =\n  'website_' +\n  websiteUrl\n    .replace(/^https?:\\/\\//, '')\n    .replace(/[^a-zA-Z0-9]/g, '_')\n    .replace(/_+$/, '');\n\nreturn [\n  {\n    json: {\n      websiteUrl,\n      question: $json.body.question,\n      collectionName\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -352,
        -144
      ],
      "id": "ff5eb5dd-f52b-42fd-bdb3-e762fb5981a3",
      "name": "Build Collection Name"
    },
