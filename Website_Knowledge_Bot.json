      "id": "10618c92-fdb2-4fd8-bb2e-723b91c54d46",
      "name": "Qdrant Search"
    },
    {
      "parameters": {
        "jsCode": "const results = $json.result || [];\n\nconst websiteUrl = $('Webhook').item.json.body.websiteUrl\n  .trim()\n  .replace(/\\/$/, '');\n\nconst question = $('Webhook').item.json.body.question;\n\nconst context = results\n  .map((r, i) => {\n    const p = r.payload || {};\n    return `Source ${i + 1}: ${p.url}\nTitle: ${p.title}\nContent:\n${p.content}`;\n  })\n  .join('\\n\\n---\\n\\n');\n\nreturn [\n  {\n    json: {\n      websiteUrl,\n      question,\n      context\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        -144
      ],
      "id": "cfc6ffa0-1bc0-4e85-b358-001eb37e8b2c",
