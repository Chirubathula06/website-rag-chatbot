      "name": "Wait",
      "webhookId": "665e9079-6995-4b80-8215-e015eac33b7b"
    },
    {
      "parameters": {
        "jsCode": "const collectionData = $('Build Collection Name').first().json;\n\nreturn [\n  {\n    json: {\n      collectionName: collectionData.collectionName,\n      websiteUrl: collectionData.websiteUrl,\n      question: collectionData.question,\n      embedding: $json.data[0].embedding\n    }\n  }\n];"
      },
