      "parameters": {
        "jsCode": "return items.map((item, index) => {\n  const chunk = $('Code Chunk Splitter').all()[index].json;\n\n  const normalizedWebsiteUrl = chunk.websiteUrl\n    .trim()\n    .replace(/\\/$/, '');\n\n  return {\n    json: {\n      points: [\n        {\n          id: Date.now() + index,\n          vector: item.json.data[0].embedding,\n          payload: {\n            websiteUrl: normalizedWebsiteUrl,\n            url: chunk.url,\n            title: chunk.title,\n            content: chunk.content\n          }\n        }\n      ]\n    }\n  };\n});"
      },
