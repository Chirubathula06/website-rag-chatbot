    {
      "parameters": {
        "jsCode": "const chunkSize = 1000;\nconst overlap = 150;\nconst output = [];\n\nfor (const item of items) {\n  const text = item.json.content || '';\n  const websiteUrl = $('Webhook').first().json.body.websiteUrl;\n\n  for (let i = 0; i < text.length; i += chunkSize - overlap) {\n    const chunk = text.slice(i, i + chunkSize);\n\n    if (chunk.length > 100) {\n      output.push({\n        json: {\n          id: Buffer.from(`${item.json.url}-${i}`)\n            .toString('base64')\n            .replace(/[^a-zA-Z0-9]/g, '')\n            .slice(0, 32),\n          websiteUrl,\n          url: item.json.url,\n          title: item.json.title,\n          content: chunk\n        }\n      });\n    }\n  }\n}\n\nreturn output;"
      },
