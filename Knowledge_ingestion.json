      "parameters": {
        "jsCode": "const pages = $json.data?.data || [];\n\nreturn pages\n  .map(page => ({\n    json: {\n      url: page.metadata?.sourceURL || page.url || '',\n      title: page.metadata?.title || '',\n      content: page.markdown || ''\n    }\n  }))\n  .filter(item => item.json.content.length > 200);"
      },
